GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# 可选：自定义 OpenAI 兼容服务 base_url。仅允许 https:// 或 http://127.0.0.1（回环，供本地 Ollama/vLLM）。
OPENAI_BASE_URL=
PROJECTX_DB_PATH=../data/projectx.db
# 必填（安全审计 F-4）：内部 API 密钥。未设置时服务将拒绝所有请求。请用强随机值：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LLMCLIENT_INTERNAL_API_KEY=
LLMCLIENT_DEFAULT_MODEL=
LLMCLIENT_HOST=127.0.0.1
LLMCLIENT_PORT=8766

# 以下为远程 MariaDB 模式配置（未配置则使用本地 SQLite）
# PROJECTX_MARIADB_HOST=127.0.0.1
# PROJECTX_MARIADB_PORT=3306
# PROJECTX_MARIADB_USER=
# PROJECTX_MARIADB_PASSWORD=
# PROJECTX_MARIADB_DATABASE=projectx
# 注意：user/password 不再提供默认值（已移除弱默认 projectx/projectx，F-8）。
