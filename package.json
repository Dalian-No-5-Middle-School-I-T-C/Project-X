{
  "name": "answer-card-designer",
  "version": "0.1.0",
  "description": "Local answer card designer and PDF exporter for Project-X.",
  "author": "Project-X",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"tsx watch src/apps/answer-card/server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsx scripts/build-server.ts",
    "electron:dev": "npm run build && electron .",
    "electron:pack": "npm run build && set ELECTRON_BUILDER_CACHE=.electron-builder-cache&& electron-builder --dir",
    "electron:dist": "npm run build && set ELECTRON_BUILDER_CACHE=.electron-builder-cache&& electron-builder --win portable",
    "electron:msi": "npm run build && set ELECTRON_BUILDER_CACHE=.electron-builder-cache&& electron-builder --win msi",
    "server": "tsx src/apps/answer-card/server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/pdfkit": "^0.17.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^9.2.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.7",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "cn.projectx.answer-card-designer",
    "productName": "答题卡设计系统",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/client/**/*",
      "dist/server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.svg",
      "executableName": "答题卡设计系统",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "答题卡设计系统-${version}-${arch}.${ext}"
    },
    "msi": {
      "artifactName": "答题卡设计系统-${version}-${arch}.${ext}",
      "shortcutName": "答题卡设计系统",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false
    }
  }
}
