{
  "name": "answer-card-designer",
  "version": "1.4.5",
  "description": "Local answer card designer and PDF exporter for Project-X.",
  "author": "Project-X",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "node scripts/ensure-native-modules.cjs",
    "dev": "concurrently \"tsx watch src/apps/answer-card/server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsx scripts/build-server.ts",
    "native:rebuild:node": "npm rebuild better-sqlite3",
    "native:rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "native:rebuild:electron:ia32": "electron-rebuild -f -a ia32 -w better-sqlite3",
    "native:build:x64": "scripts\\build-answer-card-recognizer.bat x64 && scripts\\build-scanner-bridge.bat x64",
    "native:build:ia32": "scripts\\build-answer-card-recognizer.bat ia32 && scripts\\build-scanner-bridge.bat ia32",
    "electron:dev": "npm run build && npm run native:rebuild:electron && electron .",
    "electron:pack": "npm run electron:pack:scanner",
    "electron:dist": "npm run electron:dist:scanner",
    "electron:msi": "npm run electron:msi:scanner",
    "electron:pack:student": "tsx scripts/package-variant.ts student dir",
    "electron:pack:teacher": "tsx scripts/package-variant.ts teacher dir",
    "electron:pack:scanner": "tsx scripts/package-variant.ts teacher-scanner dir",
    "electron:pack:student:ia32": "tsx scripts/package-variant.ts student dir ia32",
    "electron:pack:teacher:ia32": "tsx scripts/package-variant.ts teacher dir ia32",
    "electron:pack:scanner:ia32": "tsx scripts/package-variant.ts teacher-scanner dir ia32",
    "electron:dist:student": "tsx scripts/package-variant.ts student portable",
    "electron:dist:teacher": "tsx scripts/package-variant.ts teacher portable",
    "electron:dist:scanner": "tsx scripts/package-variant.ts teacher-scanner portable",
    "electron:dist:student:ia32": "tsx scripts/package-variant.ts student portable ia32",
    "electron:dist:teacher:ia32": "tsx scripts/package-variant.ts teacher portable ia32",
    "electron:dist:scanner:ia32": "tsx scripts/package-variant.ts teacher-scanner portable ia32",
    "electron:msi:student": "tsx scripts/package-variant.ts student msi",
    "electron:msi:teacher": "tsx scripts/package-variant.ts teacher msi",
    "electron:msi:scanner": "tsx scripts/package-variant.ts teacher-scanner msi",
    "electron:msi:student:ia32": "tsx scripts/package-variant.ts student msi ia32",
    "electron:msi:teacher:ia32": "tsx scripts/package-variant.ts teacher msi ia32",
    "electron:msi:scanner:ia32": "tsx scripts/package-variant.ts teacher-scanner msi ia32",
    "electron:msi:all": "tsx scripts/package-variant.ts all msi",
    "server": "tsx src/apps/answer-card/server/index.ts",
    "verify:auth": "tsx scripts/verify-auth.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "expr-eval": "^2.0.2",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/pdfkit": "^0.17.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.7",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "cn.projectx.answer-card-designer",
    "productName": "答题卡设计系统",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/client/**/*",
      "dist/server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/native/win-x64",
        "to": "native/win-x64",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "icon": "resources/icon.png",
      "executableName": "答题卡设计系统",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "答题卡设计系统-${version}-${arch}.${ext}"
    },
    "msi": {
      "artifactName": "答题卡设计系统-${version}-${arch}.${ext}",
      "shortcutName": "答题卡设计系统",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false
    }
  }
}
