async function showSection(sectionId) {
  document.querySelectorAll('.sidebar-item').forEach(el => {
    el.classList.remove('active');
    if (el.dataset.section === sectionId) el.classList.add('active');
  });
  const content = document.getElementById('mainContent');
  content.innerHTML = '<div class="flex items-center justify-center h-64"><div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div></div>';
  Object.values(charts).forEach(c => c.destroy && c.destroy());
  charts = {};

  try {
    if (sectionId === 'teacherOverview') await renderTeacherOverview();
    else if (sectionId === 'teacherStudents') await renderTeacherStudents();
    else if (sectionId === 'teacherClassCompare') await renderTeacherClassCompare();
    else if (sectionId === 'teacherAnalysis') await renderTeacherAnalysis();
    else if (sectionId === 'studentDashboard') await renderStudentDashboard();
    else if (sectionId === 'studentTrend') await renderStudentTrend();
    else if (sectionId === 'studentAnalysis') await renderStudentAnalysis();
  } catch (e) {
    content.innerHTML = '<div class="text-center text-red-500 p-8">加载失败: ' + e.message + '</div>';
    console.error(e);
  }
}

function filterByExam() {
