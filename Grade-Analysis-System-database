            '<div class="text-xs text-blue-600/70 mt-1">最新总分</div>' +
          '</div>' +
          '<div class="bg-emerald-50 rounded-xl p-4 text-center">' +
            '<div class="text-2xl font-bold text-emerald-600">' + classRank.rank + '/' + classRank.total + '</div>' +
