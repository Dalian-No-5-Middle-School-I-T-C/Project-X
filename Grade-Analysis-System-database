async function renderTeacherAnalysis() {
  document.getElementById('pageTitle').textContent = '成绩总结报告';
  const examId = document.getElementById('examFilter').value;
  const exams = await fetchExams();
  const targetExam = examId === 'all' ? exams[exams.length - 1] : exams.find(e => e.id === examId);
  const gradeStats = await fetchGradeStats(targetExam.id);
  const classStats = await fetchClassStats(targetExam.id);
  const allScores = await fetchExamScores(targetExam.id);

  classStats.sort((a, b) => b.totalAvg - a.totalAvg);
  const bestClass = classStats[0];
  const weakClass = classStats[classStats.length - 1];

  const subjectAvgs = targetExam.subjects.map(s => ({
    name: s.name,
    avg: gradeStats.subjectAvgs[s.name]
  }));
  subjectAvgs.sort((a, b) => b.avg - a.avg);
  const bestSubject = subjectAvgs[0];
  const weakSubject = subjectAvgs[subjectAvgs.length - 1];

  const excellent = allScores.filter(s => s.totalScore >= 720).length;
  const good = allScores.filter(s => s.totalScore >= 600 && s.totalScore < 720).length;
  const pass = allScores.filter(s => s.totalScore >= 450 && s.totalScore < 600).length;
  const fail = allScores.filter(s => s.totalScore < 450).length;

  const mean = gradeStats.totalAvg;
  const variance = allScores.reduce((acc, s) => acc + Math.pow(s.totalScore - mean, 2), 0) / allScores.length;
  const stdDev = Math.sqrt(variance).toFixed(1);

  let html = '<div class="max-w-4xl mx-auto space-y-6 fade-in">' +
    '<div class="bg-gradient-to-r from-blue-600 to-indigo-600 rounded-xl p-8 text-white shadow-lg">' +
      '<h3 class="text-2xl font-bold mb-2">' + targetExam.name + ' 成绩分析报告</h3>' +
      '<p class="text-blue-100">生成时间：' + new Date().toLocaleString('zh-CN') + '</p>' +
      '<p class="text-blue-100 text-sm mt-1">数据来源：' + (apiMode === 'live' ? 'Project-X 后端 API' : '演示数据') + '</p>' +
    '</div>' +
    '<div class="bg-white rounded-xl p-6 shadow-sm border border-slate-100">' +
      '<h4 class="font-bold text-slate-800 mb-4 flex items-center gap-2">' +
        '<span class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center text-sm">1</span>' +
        '整体概况' +
      '</h4>' +
      '<div class="prose text-slate-600 leading-relaxed">' +
        '<p>本次考试（' + targetExam.name + '）全年级共 ' + allScores.length + ' 名学生参加，覆盖 ' + classStats.length + ' 个班级。年级总平均分为 <strong class="text-slate-800">' + gradeStats.totalAvg + '</strong> 分，标准差为 ' + stdDev + '，成绩离散程度' + (stdDev > 80 ? '较大，学生水平差异明显，建议关注分层教学' : '适中，整体水平较为均衡') + '。</p>' +
        '<p class="mt-2">成绩分布情况：优秀（≥720分）' + excellent + '人，良好（600-720分）' + good + '人，及格（450-600分）' + pass + '人，不及格（<450分）' + fail + '人。及格率为 ' + ((excellent+good+pass)/allScores.length*100).toFixed(1) + '%。</p>' +
      '</div>' +
    '</div>' +
    '<div class="bg-white rounded-xl p-6 shadow-sm border border-slate-100">' +
      '<h4 class="font-bold text-slate-800 mb-4 flex items-center gap-2">' +
        '<span class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center text-sm">2</span>' +
        '班级对比分析' +
      '</h4>' +
      '<div class="prose text-slate-600 leading-relaxed">' +
        '<p>在本次考试中，<strong class="text-emerald-600">' + bestClass.className + '</strong> 表现最为突出，班级平均分达到 ' + bestClass.totalAvg + ' 分，位居年级第一。</p>' +
        '<p class="mt-2"><strong class="text-amber-600">' + weakClass.className + '</strong> 本次平均分为 ' + weakClass.totalAvg + ' 分，与第一名相差 ' + (bestClass.totalAvg - weakClass.totalAvg).toFixed(1) + ' 分。建议重点关注该班级的薄弱科目，制定针对性提升计划。</p>' +
      '</div>' +
      '<div class="mt-4 grid grid-cols-2 md:grid-cols-4 gap-3">' +
        classStats.map(c =>
          '<div class="bg-slate-50 rounded-lg p-3 text-center">' +
            '<div class="text-xs text-slate-500">' + c.className.replace(/.*\((.*)\).*/, '$1') + '</div>' +
            '<div class="text-lg font-bold ' + (c === bestClass ? 'text-emerald-600' : c === weakClass ? 'text-amber-600' : 'text-slate-700') + '">' + c.totalAvg + '</div>' +
            '<div class="text-xs text-slate-400">平均分</div>' +
          '</div>'
        ).join('') +
      '</div>' +
    '</div>' +
    '<div class="bg-white rounded-xl p-6 shadow-sm border border-slate-100">' +
      '<h4 class="font-bold text-slate-800 mb-4 flex items-center gap-2">' +
        '<span class="w-8 h-8 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center text-sm">3</span>' +
        '科目分析' +
      '</h4>' +
      '<div class="prose text-slate-600 leading-relaxed">' +
        '<p>从各科平均分来看，<strong class="text-emerald-600">' + bestSubject.name + '</strong> 是年级整体表现最好的科目，平均分达到 ' + bestSubject.avg + ' 分；而 <strong class="text-amber-600">' + weakSubject.name + '</strong> 相对薄弱，平均分为 ' + weakSubject.avg + ' 分，两科相差 ' + (bestSubject.avg - weakSubject.avg).toFixed(1) + ' 分。</p>' +
        '<p class="mt-2">建议：针对 ' + weakSubject.name + ' 科目，可考虑增加课后辅导、优化教学方法，并分析该科目的试卷难度与区分度是否合理。</p>' +
      '</div>' +
    '</div>' +
    '<div class="bg-white rounded-xl p-6 shadow-sm border border-slate-100">' +
      '<h4 class="font-bold text-slate-800 mb-4 flex items-center gap-2">' +
