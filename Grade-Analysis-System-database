<script>

// ==================== 全局配置 ====================
const API_BASE = ''; // 空字符串表示同源，如需跨域请改为后端地址如 'http://localhost:5174'
let apiMode = 'live'; // 'live' = 对接后端, 'demo' = 演示模式
let authToken = null;
let currentUser = null;
let currentRole = null;
let currentStudent = null;
let appData = { exams: [], students: [], scores: [], classes: [] };
let charts = {};

// ==================== API 封装层 ====================
async function apiGet(path) {
  if (apiMode === 'demo') throw new Error('DEMO_MODE');
  const res = await fetch(API_BASE + path, {
    headers: authToken ? { 'Authorization': 'Bearer ' + authToken } : {}
  });
  if (!res.ok) throw new Error('HTTP ' + res.status);
  return res.json();
}

async function apiPost(path, body) {
  if (apiMode === 'demo') throw new Error('DEMO_MODE');
  const res = await fetch(API_BASE + path, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      ...(authToken ? { 'Authorization': 'Bearer ' + authToken } : {})
    },
    body: JSON.stringify(body)
  });
  if (!res.ok) throw new Error('HTTP ' + res.status);
  return res.json();
}

// ==================== 后端接口映射（与 Project-X 对接）====================
// 以下为预期后端 API，请根据实际后端路由调整
const API = {
  // 认证
  login: (u, p) => apiPost('/api/auth/login', { username: u, password: p }),
  // 考试
  getExams: () => apiGet('/api/exams'),
  getExam: (id) => apiGet('/api/exams/' + id),
  // 学生
  getStudents: () => apiGet('/api/students'),
  getStudent: (id) => apiGet('/api/students/' + id),
  // 成绩
  getScores: (params) => apiGet('/api/scores?' + new URLSearchParams(params)),
  getStudentScores: (studentId) => apiGet('/api/students/' + studentId + '/scores'),
  getExamScores: (examId, className) => apiGet('/api/exams/' + examId + '/scores' + (className ? '?class=' + encodeURIComponent(className) : '')),
  // 统计
  getClassStats: (examId) => apiGet('/api/stats/exam/' + examId + '/classes'),
  getGradeStats: (examId) => apiGet('/api/stats/exam/' + examId + '/grade'),
  // 排名
  getRankings: (examId, scope) => apiGet('/api/rankings/' + examId + '?scope=' + (scope || 'grade'))
};

// ==================== 演示数据生成器（仅离线模式使用）====================
function generateDemoData() {
  const subjects = ['语文', '数学', '英语', '物理', '化学', '生物'];
  const classNames = ['高一(1)班', '高一(2)班', '高一(3)班', '高一(4)班'];
  const examNames = ['第一次月考', '期中考试', '第二次月考', '期末考试'];

  appData.exams = examNames.map((name, i) => ({
    id: 'exam_' + i,
    name: name,
    date: '2025-' + (9 + Math.floor(i/2)) + '-' + (15 + (i%2)*15),
    subjects: subjects.map(s => ({ name: s, maxScore: 150 }))
  }));

  appData.classes = classNames;

  const lastNames = ['赵', '钱', '孙', '李', '周', '吴', '郑', '王', '冯', '陈', '褚', '卫', '蒋', '沈', '韩', '杨'];
  const firstNames = ['伟', '芳', '娜', '敏', '静', '丽', '强', '磊', '军', '洋', '勇', '艳', '杰', '娟', '涛', '明'];

  appData.students = [];
  let studentId = 0;
  classNames.forEach((cls, ci) => {
    for (let i = 0; i < 15; i++) {
      const name = lastNames[Math.floor(Math.random() * lastNames.length)] +
        firstNames[Math.floor(Math.random() * firstNames.length)] +
        (Math.random() > 0.5 ? firstNames[Math.floor(Math.random() * firstNames.length)] : '');
      appData.students.push({
        id: 'stu_' + studentId,
        name: name,
        className: cls,
        studentNo: '2025' + String(ci+1).padStart(2,'0') + String(i+1).padStart(2,'0')
      });
      studentId++;
    }
  });

  appData.scores = [];
  appData.students.forEach(stu => {
    const baseAbility = {};
    subjects.forEach(s => { baseAbility[s] = 60 + Math.random() * 70; });
    appData.exams.forEach((exam, ei) => {
      const subjectScores = {};
      let total = 0;
      subjects.forEach(s => {
        const trend = ei * (Math.random() * 6 - 2);
        const noise = (Math.random() - 0.5) * 20;
        let score = Math.round(baseAbility[s] + trend + noise);
        score = Math.max(0, Math.min(150, score));
        subjectScores[s] = score;
        total += score;
      });
      appData.scores.push({
        studentId: stu.id,
        examId: exam.id,
        subjectScores: subjectScores,
        totalScore: total
      });
    });
  });
}

// ==================== 数据访问层（统一封装，自动切换 live/demo）====================
async function fetchExams() {
  if (apiMode === 'demo') return appData.exams;
  return API.getExams();
}

async function fetchStudents() {
  if (apiMode === 'demo') return appData.students;
  return API.getStudents();
}

async function fetchScores(params) {
  if (apiMode === 'demo') {
    let scores = appData.scores;
    if (params.examId) scores = scores.filter(s => s.examId === params.examId);
    if (params.studentId) scores = scores.filter(s => s.studentId === params.studentId);
    if (params.className) {
      const stuIds = appData.students.filter(st => st.className === params.className).map(st => st.id);
      scores = scores.filter(s => stuIds.includes(s.studentId));
    }
    return scores;
  }
  return API.getScores(params);
}

async function fetchStudentScores(studentId) {
  if (apiMode === 'demo') {
    return appData.scores.filter(s => s.studentId === studentId).sort((a, b) => {
      const idxA = appData.exams.findIndex(e => e.id === a.examId);
      const idxB = appData.exams.findIndex(e => e.id === b.examId);
      return idxA - idxB;
    });
  }
  return API.getStudentScores(studentId);
}

async function fetchExamScores(examId, className) {
  if (apiMode === 'demo') {
    let scores = appData.scores.filter(s => s.examId === examId);
    if (className) {
      const stuIds = appData.students.filter(st => st.className === className).map(st => st.id);
      scores = scores.filter(s => stuIds.includes(s.studentId));
    }
    return scores;
  }
  return API.getExamScores(examId, className);
}

async function fetchClassStats(examId) {
  if (apiMode === 'demo') {
    return appData.classes.map(cls => {
      const scores = appData.scores.filter(s => s.examId === examId);
      const stuIds = appData.students.filter(st => st.className === cls).map(st => st.id);
      const clsScores = scores.filter(s => stuIds.includes(s.studentId));
      const subjects = appData.exams.find(e => e.id === examId).subjects.map(s => s.name);
      const subjectAvgs = {};
      subjects.forEach(sub => {
        const sum = clsScores.reduce((acc, s) => acc + s.subjectScores[sub], 0);
        subjectAvgs[sub] = clsScores.length ? Math.round(sum / clsScores.length * 10) / 10 : 0;
      });
      const totalSum = clsScores.reduce((acc, s) => acc + s.totalScore, 0);
      return {
        className: cls,
        count: clsScores.length,
        totalAvg: clsScores.length ? Math.round(totalSum / clsScores.length * 10) / 10 : 0,
        subjectAvgs: subjectAvgs,
        maxScore: clsScores.length ? Math.max(...clsScores.map(s => s.totalScore)) : 0,
        minScore: clsScores.length ? Math.min(...clsScores.map(s => s.totalScore)) : 0
      };
    });
  }
  return API.getClassStats(examId);
}

async function fetchGradeStats(examId) {
  if (apiMode === 'demo') {
    const scores = appData.scores.filter(s => s.examId === examId);
    const subjects = appData.exams.find(e => e.id === examId).subjects.map(s => s.name);
    const subjectAvgs = {};
    subjects.forEach(sub => {
      const sum = scores.reduce((acc, s) => acc + s.subjectScores[sub], 0);
      subjectAvgs[sub] = scores.length ? Math.round(sum / scores.length * 10) / 10 : 0;
    });
    const totalSum = scores.reduce((acc, s) => acc + s.totalScore, 0);
    return {
      totalAvg: scores.length ? Math.round(totalSum / scores.length * 10) / 10 : 0,
      subjectAvgs: subjectAvgs,
      maxScore: scores.length ? Math.max(...scores.map(s => s.totalScore)) : 0,
      count: scores.length
    };
  }
  return API.getGradeStats(examId);
}

async function fetchRankings(examId, scope, studentId) {
  if (apiMode === 'demo') {
    const student = appData.students.find(s => s.id === studentId);
    let scores = appData.scores.filter(s => s.examId === examId);
    if (scope === 'class') {
      const stuIds = appData.students.filter(st => st.className === student.className).map(st => st.id);
      scores = scores.filter(s => stuIds.includes(s.studentId));
    }
    scores.sort((a, b) => b.totalScore - a.totalScore);
    const rank = scores.findIndex(s => s.studentId === studentId) + 1;
    return { rank, total: scores.length };
  }
  const data = await API.getRankings(examId, scope);
  const entry = data.find(d => d.studentId === studentId);
  return entry || { rank: '-', total: data.length };
}

// ==================== 健康检查 ====================
async function checkApiHealth() {
  const statusEl = document.getElementById('apiStatus');
  statusEl.innerHTML = '<span class="text-xs text-slate-500">&#x1F504; 检测中...</span>';
  try {
    // 尝试访问后端健康检查端点（请根据实际后端调整）
    const res = await fetch(API_BASE + '/api/health', { method: 'GET', signal: AbortSignal.timeout(3000) });
    if (res.ok) {
      apiMode = 'live';
      statusEl.innerHTML = '<span class="api-badge api-live">&#x1F7E2; 后端已连接</span>';
      updateApiIndicator();
      return true;
    }
  } catch (e) {
    // 尝试 ping 根路径
    try {
      const res2 = await fetch(API_BASE + '/', { method: 'HEAD', signal: AbortSignal.timeout(3000) });
      if (res2.ok) {
        apiMode = 'live';
        statusEl.innerHTML = '<span class="api-badge api-live">&#x1F7E2; 后端已连接</span>';
        updateApiIndicator();
        return true;
      }
    } catch (e2) {}
  }
  apiMode = 'demo';
  statusEl.innerHTML = '<span class="api-badge api-demo">&#x1F7E1; 演示模式（无后端）</span>';
  updateApiIndicator();
  return false;
}

function updateApiIndicator() {
  const el = document.getElementById('apiIndicator');
  if (!el) return;
  if (apiMode === 'live') {
    el.className = 'api-badge api-live';
    el.textContent = '&#x1F7E2; API 在线';
  } else {
    el.className = 'api-badge api-demo';
    el.textContent = '&#x1F7E1; 演示模式';
  }
}

// ==================== 登录与角色选择 ====================
function selectRole(role) {
  currentRole = role;
  document.querySelectorAll('.role-btn').forEach(btn => {
    btn.classList.remove('border-blue-500', 'bg-blue-50');
    btn.classList.add('border-slate-200');
  });
  document.getElementById(role === 'teacher' ? 'btnTeacher' : 'btnStudent').classList.add('border-blue-500', 'bg-blue-50');
  document.getElementById('loginForm').classList.remove('hidden');

  if (role === 'student' && apiMode === 'demo') {
    document.getElementById('studentSelector').classList.remove('hidden');
    const select = document.getElementById('studentSelect');
    select.innerHTML = appData.students.map(s => '<option value="' + s.id + '">' + s.name + ' (' + s.className + ')</option>').join('');
  } else {
    document.getElementById('studentSelector').classList.add('hidden');
  }
}

async function handleLogin() {
  const username = document.getElementById('username').value;
  const password = document.getElementById('password').value;
  if (!username) { alert('请输入用户名'); return; }

  if (apiMode === 'live') {
    try {
      const res = await API.login(username, password);
      authToken = res.token;
      currentUser = res.user;
      currentRole = res.user.role; // 'teacher' or 'student'
      if (currentRole === 'student') {
        currentStudent = res.user;
      }
    } catch (e) {
      alert('登录失败: ' + e.message + '\n请检查后端是否运行，或切换到演示模式。');
      return;
    }
  } else {
    // 演示模式登录
    if (currentRole === 'student') {
      const stuId = document.getElementById('studentSelect').value;
      currentStudent = appData.students.find(s => s.id === stuId);
      currentUser = { name: currentStudent.name, role: 'student', id: currentStudent.id };
    } else {
      currentUser = { name: username || '教师', role: 'teacher', id: 'teacher_1' };
    }
  }

  document.getElementById('loginPage').classList.add('hidden');
  document.getElementById('appPage').classList.remove('hidden');
  document.getElementById('userName').textContent = currentUser.name;
  document.getElementById('userRole').textContent = currentRole === 'teacher' ? '教师端' : '学生端';
  document.getElementById('userAvatar').textContent = currentUser.name[0];
  updateApiIndicator();

  initSidebar();
  await initExamFilter();

  if (currentRole === 'teacher') {
    showSection('teacherOverview');
  } else {
    showSection('studentDashboard');
  }
}

function logout() {
  authToken = null;
  currentUser = null;
  currentRole = null;
  currentStudent = null;
  location.reload();
}

async function loadDemoData() {
  apiMode = 'demo';
  generateDemoData();
  document.getElementById('apiStatus').innerHTML = '<span class="api-badge api-demo">&#x1F7E1; 演示模式（已加载）</span>';
  if (currentRole === 'student') {
    const select = document.getElementById('studentSelect');
    select.innerHTML = appData.students.map(s => '<option value="' + s.id + '">' + s.name + ' (' + s.className + ')</option>').join('');
  }
  alert('演示数据已加载！请选择角色登录体验。');
}

// ==================== 侧边栏与导航 ====================
function initSidebar() {
  const nav = document.getElementById('sidebarNav');
  let items = [];
  if (currentRole === 'teacher') {
    items = [
      { id: 'teacherOverview', icon: '&#x1F4CA;', label: '数据概览' },
      { id: 'teacherStudents', icon: '&#x1F465;', label: '学生成绩' },
      { id: 'teacherClassCompare', icon: '&#x1F4C8;', label: '班级对比' },
      { id: 'teacherAnalysis', icon: '&#x1F4DD;', label: '成绩总结' }
