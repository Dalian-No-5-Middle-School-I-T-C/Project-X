  setTimeout(() => {
    charts.detailTrend = new Chart(document.getElementById('detailTrendChart'), {
      type: 'line',
      data: {
        labels: scores.map(s => exams.find(e => e.id === s.examId).name),
        datasets: datasets
      },
      options: { responsive: true, interaction: { mode: 'index', intersect: false } }
    });
  }, 50);
}

