async function renderStudentAnalysis() {
  const stu = currentStudent;
  const scores = await fetchStudentScores(stu.id);
  const exams = await fetchExams();
  const latestExam = exams[exams.length - 1];
  const latestScore = scores.find(s => s.examId === latestExam.id);
  const classStats = await fetchClassStats(latestExam.id);
  const classAvg = classStats.find(c => c.className === stu.className);
  const gradeStats = await fetchGradeStats(latestExam.id);

  document.getElementById('pageTitle').textContent = '成绩分析';

  const subjects = latestExam.subjects;
  let strongSubjects = [];
  let weakSubjects = [];
  let improvedSubjects = [];
  let declinedSubjects = [];

  for (const s of subjects) {
    const current = latestScore.subjectScores[s.name];
    const classMean = classAvg ? classAvg.subjectAvgs[s.name] : 0;
    if (current >= classMean + 10) strongSubjects.push(s.name);
    else if (current <= classMean - 10) weakSubjects.push(s.name);

    if (scores.length >= 2) {
      const prev = scores[scores.length - 2].subjectScores[s.name];
      const change = current - prev;
      if (change >= 8) improvedSubjects.push({name: s.name, change: change});
      else if (change <= -8) declinedSubjects.push({name: s.name, change: change});
    }
  }

  let totalTrend = '稳定';
  let totalTrendColor = 'text-slate-600';
  if (scores.length >= 2) {
    const diff = scores[scores.length-1].totalScore - scores[scores.length-2].totalScore;
    if (diff > 20) { totalTrend = '显著进步'; totalTrendColor = 'text-emerald-600'; }
    else if (diff > 5) { totalTrend = '有所进步'; totalTrendColor = 'text-emerald-500'; }
    else if (diff < -20) { totalTrend = '明显退步'; totalTrendColor = 'text-red-600'; }
    else if (diff < -5) { totalTrend = '略有下滑'; totalTrendColor = 'text-amber-600'; }
  }

  let html = '<div class="max-w-4xl mx-auto space-y-6 fade-in">' +
    '<div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-xl p-6 text-white shadow-lg">' +
      '<h3 class="text-xl font-bold mb-2">' + stu.name + ' 的成绩诊断报告</h3>' +
      '<p class="text-indigo-100">基于 ' + exams.length + ' 次考试数据的' + (apiMode === 'live' ? '智能分析（后端数据）' : '演示分析') + '</p>' +
    '</div>' +
    '<div class="grid grid-cols-1 md:grid-cols-2 gap-6">' +
      '<div class="bg-white rounded-xl p-6 shadow-sm border border-slate-100">' +
        '<h4 class="font-bold text-slate-800 mb-4 flex items-center gap-2">' +
          '<span class="w-6 h-6 rounded bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs">&#x2713;</span>' +
          '优势科目' +
        '</h4>' +
        (strongSubjects.length > 0 ?
          '<div class="space-y-2">' +
            strongSubjects.map(sub => {
              const score = latestScore.subjectScores[sub];
              const avg = classAvg ? classAvg.subjectAvgs[sub] : 0;
              return '<div class="flex items-center justify-between p-3 bg-emerald-50 rounded-lg">' +
                '<span class="font-medium text-emerald-800">' + sub + '</span>' +
                '<span class="text-sm text-emerald-600">' + score + '分 (超班均' + (score-avg).toFixed(1) + ')</span>' +
              '</div>';
            }).join('') +
          '</div>' +
          '<p class="text-sm text-slate-500 mt-3">这些科目是你的优势领域，建议保持现有学习方法。</p>'
          : '<p class="text-slate-500 text-sm">暂无显著优势科目，建议均衡发展。</p>') +
      '</div>' +
      '<div class="bg-white rounded-xl p-6 shadow-sm border border-slate-100">' +
        '<h4 class="font-bold text-slate-800 mb-4 flex items-center gap-2">' +
          '<span class="w-6 h-6 rounded bg-amber-100 text-amber-600 flex items-center justify-center text-xs">!</span>' +
          '薄弱科目' +
        '</h4>' +
        (weakSubjects.length > 0 ?
          '<div class="space-y-2">' +
            weakSubjects.map(sub => {
              const score = latestScore.subjectScores[sub];
              const avg = classAvg ? classAvg.subjectAvgs[sub] : 0;
              return '<div class="flex items-center justify-between p-3 bg-amber-50 rounded-lg">' +
                '<span class="font-medium text-amber-800">' + sub + '</span>' +
                '<span class="text-sm text-amber-600">' + score + '分 (低班均' + (avg-score).toFixed(1) + ')</span>' +
              '</div>';
            }).join('') +
          '</div>' +
          '<p class="text-sm text-slate-500 mt-3">建议增加这些科目的学习时间，针对性刷题。</p>'
          : '<p class="text-slate-500 text-sm">暂无显著薄弱科目，继续保持！</p>') +
      '</div>' +
    '</div>' +
    '<div class="bg-white rounded-xl p-6 shadow-sm border border-slate-100">' +
      '<h4 class="font-bold text-slate-800 mb-4">总体评价</h4>' +
      '<div class="prose text-slate-600 leading-relaxed">' +
        '<p>在最近的 <strong>' + latestExam.name + '</strong> 中，你的总分为 <strong>' + latestScore.totalScore + '</strong> 分，在班级中排名第 <strong>' + (await fetchRankings(latestExam.id, 'class', stu.id)).rank + '</strong>，在年级中排名第 <strong>' + (await fetchRankings(latestExam.id, 'grade', stu.id)).rank + '</strong>。</p>' +
