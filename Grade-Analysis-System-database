function renderStudentRow(stu, exam) {
  const rankClass = stu.gradeRank.rank <= 3 ? 'rank-' + stu.gradeRank.rank : 'rank-other';
  return '<tr class="hover:bg-slate-50 transition-colors">' +
    '<td class="px-6 py-4"><span class="rank-badge ' + rankClass + '">' + stu.gradeRank.rank + '</span></td>' +
    '<td class="px-6 py-4"><span class="rank-badge rank-other">' + stu.classRank.rank + '</span></td>' +
    '<td class="px-6 py-4 font-medium text-slate-800">' + stu.name + '</td>' +
    '<td class="px-6 py-4 text-slate-600">' + stu.className + '</td>' +
    '<td class="px-6 py-4 text-slate-500 font-mono text-xs">' + stu.studentNo + '</td>' +
    '<td class="px-6 py-4 font-bold text-blue-600">' + stu.score.totalScore + '</td>' +
    exam.subjects.map(s => {
