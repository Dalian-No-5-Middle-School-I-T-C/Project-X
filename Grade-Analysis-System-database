        '<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">' +
          latestExam.subjects.map(s => {
            const score = latestScore ? latestScore.subjectScores[s.name] : 0;
            const pct = Math.round(score / s.maxScore * 100);
            const color = pct >= 80 ? 'bg-emerald-100 text-emerald-700' : pct >= 60 ? 'bg-blue-100 text-blue-700' : 'bg-amber-100 text-amber-700';
            return '<div class="' + color + ' rounded-lg p-3 text-center">' +
              '<div class="text-xs opacity-70">' + s.name + '</div>' +
              '<div class="text-xl font-bold">' + score + '</div>' +
              '<div class="text-xs opacity-70">' + pct + '%</div>' +
            '</div>';
          }).join('') +
        '</div>' +
      '</div>' +
    '</div>' +
  '</div>';

  const modal = document.createElement('div');
  modal.id = 'detailModal';
