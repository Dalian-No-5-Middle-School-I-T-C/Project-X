        '<p class="mt-2">成绩总体趋势：<strong class="' + totalTrendColor + '">' + totalTrend + '</strong>。</p>' +
        (improvedSubjects.length > 0 ? '<p class="mt-2 text-emerald-600">&#x1F4C8; 进步明显的科目：' + improvedSubjects.map(s => s.name + '(+' + s.change + ')').join('、') + '，继续保持！</p>' : '') +
        (declinedSubjects.length > 0 ? '<p class="mt-2 text-amber-600">&#x1F4C9; 需要关注的科目：' + declinedSubjects.map(s => s.name + '(' + s.change + ')').join('、') + '，建议分析原因。</p>' : '') +
      '</div>' +
    '</div>' +
    '<div class="bg-blue-50 rounded-xl p-6 border border-blue-100">' +
      '<h4 class="font-bold text-blue-800 mb-3">&#x1F4A1; 个性化学习建议</h4>' +
      '<ul class="space-y-2 text-blue-700 text-sm">' +
        (weakSubjects.length > 0 ? '<li>&#x2022; 优先补习：' + weakSubjects.join('、') + '，建议每天额外安排30分钟专项练习。</li>' : '') +
        (strongSubjects.length > 0 ? '<li>&#x2022; 保持优势：' + strongSubjects.join('、') + '，可适当减少时间，用于攻克薄弱科目。</li>' : '') +
        '<li>&#x2022; 建立错题本，定期回顾 ' + subjects.map(s=>s.name).join('、') + ' 的易错知识点。</li>' +
        '<li>&#x2022; 关注考试心态调整，避免因紧张导致发挥失常。</li>' +
      '</ul>' +
    '</div>' +
  '</div>';

  document.getElementById('mainContent').innerHTML = html;
}

// ==================== 工具函数 ====================
function exportData() {
  const dataStr = JSON.stringify(appData, null, 2);
  const blob = new Blob([dataStr], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'project-x-scores.json';
  a.click();
  URL.revokeObjectURL(url);
}

// 初始化
document.addEventListener('DOMContentLoaded', () => {
  checkApiHealth();
});
</script>
