[Unit]
Description=Project-X answer card web service
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
WorkingDirectory=/root/project/dlwz/project-x-server-ubuntu24-1.5.1
EnvironmentFile=/etc/project-x/project-x.env
ExecStart=/root/.nvm/versions/node/v25.8.2/bin/node dist/server/index.mjs
Restart=always
RestartSec=3
StandardOutput=append:/var/log/project-x/service.log
StandardError=append:/var/log/project-x/error.log

[Install]
WantedBy=multi-user.target