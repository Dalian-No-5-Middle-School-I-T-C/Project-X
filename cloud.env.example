# Project-X Cloud Desktop environment (copy to cloud.env and source before npm run dev)
# Usage: set -a && source cloud.env && set +a && npm run dev

# --- SQLite mode (default) ---
# Leave PROJECTX_MARIADB_HOST unset to use embedded SQLite at data/projectx.db

# --- MariaDB mode (dual-database branch) ---
# PROJECTX_MARIADB_HOST=127.0.0.1
# PROJECTX_MARIADB_PORT=3306
# PROJECTX_MARIADB_USER=projectx_app
# PROJECTX_MARIADB_PASSWORD=change_me
# PROJECTX_MARIADB_DATABASE=projectx

# Optional: Python AI analysis service (llmclient on port 8766)
# LLMCLIENT_URL=http://127.0.0.1:8766
